# Convierte a número aceptando coma decimal (FEX_C18 viene con coma)
a_num <- function(x) suppressWarnings(as.numeric(gsub(",", ".", as.character(x))))

# Lee un módulo y conserva solo las variables pedidas que existan.
# Devuelve NULL si el archivo no está, para que el bucle siga.
leer_modulo <- function(ruta, vars) {
  if (!file.exists(ruta)) return(NULL)
  cab <- names(fread(ruta, sep = ";", nrows = 0))
  sel <- cab[toupper(cab) %in% vars]
  if (length(sel) == 0) return(NULL)
  dt <- fread(ruta, sep = ";", select = sel, colClasses = "character",
              showProgress = FALSE)
  setnames(dt, toupper(names(dt)))
  dt[, (names(dt)) := lapply(.SD, a_num)]
  as_tibble(dt)
}

# Estadísticas ponderadas
wtd_quantile <- function(x, w, probs) {
  ok <- !is.na(x) & !is.na(w); x <- x[ok]; w <- w[ok]
  o <- order(x); x <- x[o]; cw <- cumsum(w[o]) / sum(w)
  sapply(probs, function(p) x[which(cw >= p)[1]])
}
wtd_sd <- function(x, w) {
  ok <- !is.na(x) & !is.na(w); x <- x[ok]; w <- w[ok]
  m <- weighted.mean(x, w); sqrt(sum(w * (x - m)^2) / sum(w))
}
estadisticas <- function(x, w, nombre) {
  ok <- !is.na(x); x <- x[ok]; w <- w[ok]
  q <- wtd_quantile(x, w, c(.25, .5, .75))
  tibble(Variable = nombre, N = length(x),
         Media = weighted.mean(x, w), DE = wtd_sd(x, w),
         Min = min(x), Q1 = q[1], Mediana = q[2], Q3 = q[3], Max = max(x))
}

# Proporción ponderada con IC 95 % usando el tamaño efectivo de Kish
resumir_prop <- function(df, y) {
  df %>%
    summarise(n = n(), sw = sum(peso), swy = sum(peso * {{ y }}),
              neff = sum(peso)^2 / sum(peso^2), .groups = "drop") %>%
    mutate(prop = swy / sw,
           se = sqrt(prop * (1 - prop) / neff),
           lo = prop - 1.96 * se, hi = prop + 1.96 * se)
}

# Combinación lineal de coeficientes (theta1 + theta2) con su error estándar
lincom <- function(mod, nombres) {
  b <- coef(mod)[nombres]; V <- vcov(mod)[nombres, nombres]
  est <- sum(b); se <- sqrt(sum(V))
  c(est = est, se = se, p = 2 * pnorm(-abs(est / se)))
}

