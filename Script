         asim_eb = -theta2_eb,                      # asimetría: caída adicional en mujeres
         asim_pp = 100 * asim_eb, caida_mujeres_pp = -100 * mujeres_eb,
         lo = theta2 - 1.96 * se_theta2, hi = theta2 + 1.96 * se_theta2)

