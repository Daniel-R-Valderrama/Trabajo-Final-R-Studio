# (a) Modelo central dentro de cada departamento (sin EF de departamento: es constante)
res_dpto <- bind_rows(lapply(sort(unique(d$cod_dpto)), function(cd) {
  dd <- d %>% filter(cod_dpto == cd)
  m  <- tryCatch(feols(univ ~ mujer * ec + mujer * n_hijos_18 + edad + edad2 | ANIO + CLASE,
                       data = dd, cluster = ~ id_hogar), error = function(e) NULL)
