# (d) MAPAS. Shapefile de departamentos del Marco Geoestadístico Nacional (DANE):
# geoportal.dane.gov.co > Descargas > MGN > nivel departamento. Como en la Clase 13,
# st_read() recibe la CARPETA con los archivos .shp, .dbf, .shx y .prj.
# Verificar el nombre del campo con el código DIVIPOLA (en el MGN suele ser DPTO_CCDGO).
RUTA_SHP  <- file.path(ruta_base, "MGN_DPTO_POLITICO")
CAMPO_SHP <- "DPTO_CCDGO"
hay_shp   <- dir.exists(RUTA_SHP)
col_lisa  <- c("Alta asimetría, vecinos altos" = "#b2182b", "Baja asimetría, vecinos bajos" = "#2166ac",
               "Alta asimetría, vecinos bajos" = "#f4a582", "Baja asimetría, vecinos altos" = "#92c5de",
               "Sin vecinos" = "gray80")

if (hay_shp) {
  dptos_sf <- st_read(RUTA_SHP, quiet = TRUE) %>%
    rename(cod_dpto = all_of(CAMPO_SHP)) %>%
    mutate(cod_dpto = sprintf("%02d", as.integer(cod_dpto))) %>%
    select(cod_dpto) %>%
    st_make_valid() %>%
    st_transform(9377)               # MAGNA-SIRGAS Origen Nacional, en metros
  st_crs(dptos_sf)$units_gdal        # debe decir metre

  # Unión por atributo: el sf va a la IZQUIERDA para conservar la geometría
  mapa_dpto <- dptos_sf %>% left_join(res_dpto, by = "cod_dpto")
  sum(is.na(mapa_dpto$theta2))       # departamentos sin estimación

  # (e) Vecindad con st_touches() sobre la geometría completa (antes de simplificar)
  # e I de Moran: correlación entre la asimetría de cada departamento y el promedio
  # de sus vecinos. p-valor por permutación: se reparte la asimetría al azar 999 veces.
  geo_ok <- mapa_dpto %>% filter(!is.na(asim_eb))
  vecinos <- st_touches(geo_ok)
  W <- matrix(0, nrow(geo_ok), nrow(geo_ok))
  for (i in seq_len(nrow(geo_ok))) W[i, vecinos[[i]]] <- 1
  W <- W / pmax(rowSums(W), 1)       # promedio de los vecinos; San Andrés no tiene
  moran_I <- function(x, W) {
    z <- x - mean(x); (length(z) / sum(W)) * sum(W * outer(z, z)) / sum(z^2)
  }
  x_asim <- geo_ok$theta2 * -100     # estimación propia, sin bayes empírico
  I_obs  <- moran_I(x_asim, W)
  set.seed(2026)
  I_perm <- replicate(999, moran_I(sample(x_asim), W))
  p_moran <- (sum(I_perm >= I_obs) + 1) / (999 + 1)
  z_asim <- x_asim - mean(x_asim); lag_asim <- as.vector(W %*% z_asim)
  geo_ok <- geo_ok %>%
    mutate(lisa = factor(case_when(rowSums(W) == 0          ~ "Sin vecinos",
                                   z_asim > 0 & lag_asim > 0 ~ "Alta asimetría, vecinos altos",
                                   z_asim < 0 & lag_asim < 0 ~ "Baja asimetría, vecinos bajos",
                                   z_asim > 0                ~ "Alta asimetría, vecinos bajos",
                                   TRUE                      ~ "Baja asimetría, vecinos altos"),
                         levels = names(col_lisa)))
  res_dpto <- res_dpto %>% left_join(st_drop_geometry(geo_ok) %>% select(cod_dpto, lisa), by = "cod_dpto")

  # Geometría simplificada solo para dibujar (más liviana). San Andrés no se dibuja
  # para que el mapa no quede diminuto; su resultado está en la Tabla A9.
  mapa_plot <- geo_ok %>% st_simplify(dTolerance = 500) %>% filter(cod_dpto != "88")

  # Función de mapas con cortes de Jenks (la de la Clase 13, con un respaldo por
  # cuantiles si hay menos de seis valores distintos)
  mapa_jenks <- function(datos, variable, titulo_leyenda, paleta) {
    x <- datos[[variable]]
    cortes <- tryCatch(unique(getJenksBreaks(x, 6)), error = function(e) NULL)
    if (length(cortes) < 3) cortes <- unique(quantile(x, 0:4 / 4))
    datos$clase <- cut(x, breaks = cortes, include.lowest = TRUE, dig.lab = 3)
    ggplot(datos) +
      geom_sf(aes(fill = clase), color = "white", linewidth = 0.1) +
      scale_fill_brewer(palette = paleta, name = titulo_leyenda) +
      theme_void() +
      theme(legend.position = "bottom", plot.title = element_text(face = "bold"),
            plot.caption = element_text(hjust = 0))
  }
  nota_mapa <- paste(fuente, "\nLínea punteada: departamentos donde la GEIH solo cubre la capital. San Andrés no se dibuja (ver Tabla A9).")
  top5 <- mapa_plot %>% arrange(desc(asim_pp)) %>% head(5)

  # G6. Mapa de la asimetría (bayes empírico), con los 5 departamentos más altos
  grafico_6 <- mapa_jenks(mapa_plot, "asim_pp", "Caída adicional por hijo en mujeres (p.p.)", "YlOrRd") +
    geom_sf(data = filter(mapa_plot, solo_capital), fill = NA, color = "gray25",
            linetype = "dashed", linewidth = 0.4) +
    geom_text_repel(data = top5, aes(label = nombre, geometry = geometry),
                    stat = "sf_coordinates", size = 3, min.segment.length = 0) +
    labs(title = "Gráfica 6. Asimetría de los hijos en el logro universitario, por departamento",
         subtitle = "−θ₂ con bayes empírico; clases por cortes naturales (Jenks)", caption = nota_mapa)

  # G7. ¿Se agrupa en el territorio? Cuadrantes del diagrama de Moran
  grafico_7 <- ggplot(mapa_plot) +
    geom_sf(aes(fill = lisa), color = "white", linewidth = 0.1) +
    scale_fill_manual(values = col_lisa, drop = FALSE, name = NULL) +
    labs(title = "Gráfica 7. Asimetría de cada departamento frente a la de sus vecinos",
         subtitle = paste0("I de Moran = ", round(I_obs, 3), " (p por permutación = ", round(p_moran, 3), ")"),
         caption = nota_mapa) +
    theme_void() + theme(legend.position = "bottom", plot.title = element_text(face = "bold"),
                         plot.caption = element_text(hjust = 0)) +
    guides(fill = guide_legend(nrow = 2))

  ggsave(file.path(ruta_resultados, "G6_mapa_asimetria.png"), grafico_6, width = 8, height = 9, dpi = 300, bg = "white")
  ggsave(file.path(ruta_resultados, "G7_mapa_vecinos.png"), grafico_7, width = 8, height = 9, dpi = 300, bg = "white")

  # Mapa interactivo (leaflet SOLO entiende WGS84 = 4326)
  mapa_wgs <- st_transform(mapa_plot, 4326)
  cortes_l <- tryCatch(unique(getJenksBreaks(mapa_wgs$asim_pp, 6)), error = function(e) NULL)
  if (length(cortes_l) < 3) cortes_l <- unique(quantile(mapa_wgs$asim_pp, 0:4 / 4))
  paleta <- colorBin("YlOrRd", domain = mapa_wgs$asim_pp, bins = cortes_l)
  paleta_m <- colorNumeric("Blues", domain = mapa_wgs$caida_mujeres_pp)
  mapa_leaflet <- leaflet() %>%
    addProviderTiles(providers$Esri.WorldStreetMap) %>%
    addPolygons(data = mapa_wgs, fillColor = ~paleta(asim_pp), fillOpacity = 0.75,
                color = "white", weight = 1, label = ~nombre,
                popup = ~paste0("<b>", nombre, "</b><br>",
                                "Asimetría (bayes empírico): ", round(asim_pp, 2), " p.p.<br>",
                                "θ₂ propio: ", round(100 * theta2, 2), " (EE ", round(100 * se_theta2, 2), ")<br>",
                                "Caída por hijo en mujeres: ", round(caida_mujeres_pp, 2), " p.p.<br>",
                                "Observaciones: ", format(n, big.mark = "."),
                                ifelse(solo_capital, "<br><i>Solo la capital</i>", "")),
                highlightOptions = highlightOptions(weight = 3, color = "black", bringToFront = TRUE),
                group = "Asimetría (−θ₂)") %>%
    addPolygons(data = mapa_wgs, fillColor = ~paleta_m(caida_mujeres_pp), fillOpacity = 0.75,
                color = "white", weight = 1, label = ~nombre, group = "Caída por hijo en mujeres") %>%
    addLegend(pal = paleta, values = mapa_wgs$asim_pp, title = "Asimetría (p.p.)", position = "bottomright") %>%
    addLayersControl(baseGroups = c("Asimetría (−θ₂)", "Caída por hijo en mujeres"),
                     options = layersControlOptions(collapsed = FALSE))
  htmlwidgets::saveWidget(mapa_leaflet, file.path(ruta_resultados, "mapa_asimetria_departamentos.html"),
                          selfcontained = TRUE)

  # Versión liviana para la Shiny App
  mapa_app <- mapa_wgs %>% select(nombre, asim_eb, mujeres_eb, lisa)
} else {
  message("No se encontró el shapefile en ", RUTA_SHP, ": se omiten mapas y prueba de Moran.")
  I_obs <- NA_real_; p_moran <- NA_real_
  res_dpto$lisa <- NA
}

