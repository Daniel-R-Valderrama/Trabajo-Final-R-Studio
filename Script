# Ecuación central (M2):
# Univ = b0 + b1 Mujer + sum g_k EC_k + sum d_k Mujer*EC_k + t1 Hijos + t2 Mujer*Hijos
#        + edad + edad^2 + FE(año) + FE(departamento) + FE(zona) + e
# t1 = asociación de un hijo con el logro de los hombres; t1 + t2 = de las mujeres.
# Errores agrupados por hogar (cabeza de hogar y cónyuge comparten choques).
d <- d %>% mutate(edad2 = edad^2)

m1 <- feols(univ ~ mujer * ec + mujer * n_hijos_18,
            data = d, cluster = ~ id_hogar)
m2 <- feols(univ ~ mujer * ec + mujer * n_hijos_18 + edad + edad2 | ANIO + DPTO + CLASE,
            data = d, cluster = ~ id_hogar)
m3 <- feols(univ ~ mujer * ec + mujer * n_hijos_18 + edad + edad2 + estrato_grp | ANIO + DPTO + CLASE,
            data = d, cluster = ~ id_hogar)
modelos <- list("M1" = m1, "M2 (central)" = m2, "M3" = m3)
if (hay_k && any(!is.na(d$horas_cuidado))) {
  m4 <- feols(univ ~ mujer * ec + mujer * n_hijos_18 + edad + edad2 + estrato_grp + horas_cuidado |
                ANIO + DPTO + CLASE, data = d, cluster = ~ id_hogar)
