server <- function(input, output, session) {
  output$t1 <- renderTable(app_datos$tabla_1, digits = 2, na = "")

  datos_filtrados <- reactive({
    req(input$f_edad, input$f_estrato, input$f_ec)
    app_datos$celdas %>%
      filter(edad_grp %in% input$f_edad, estrato_grp %in% input$f_estrato, ec %in% input$f_ec) %>%
      group_by(x = .data[[input$f_x]], sexo) %>%
      summarise(n = sum(n), prop = sum(swy) / sum(sw), neff = sum(sw)^2 / sum(sw2), .groups = "drop") %>%
      mutate(se = sqrt(prop * (1 - prop) / neff), lo = prop - 1.96 * se, hi = prop + 1.96 * se)
  })
  output$g_explorar <- renderPlot({
    ggplot(datos_filtrados(), aes(x, prop, color = sexo, group = sexo)) +
      geom_line(linewidth = 1) + geom_pointrange(aes(ymin = lo, ymax = hi)) +
      scale_y_continuous(labels = percent_format(accuracy = 1)) +
      scale_color_manual(values = col_g) +
      labs(title = "Proporción con educación universitaria o posgrado", x = NULL,
           y = "Proporción", color = "Sexo", caption = fuente) + tema
  })
  output$t_explorar <- renderTable(
    datos_filtrados() %>% transmute(Grupo = x, Sexo = sexo, N = n, `% universitaria` = 100 * prop),
    digits = 1)

  output$g_coefs <- renderPlot({
    app_datos$coefs %>% filter(Modelo == input$f_mod) %>%
      ggplot(aes(Coef, reorder(Variable, Coef))) +
      geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
      geom_pointrange(aes(xmin = lo, xmax = hi), color = "#333333") +
      scale_x_continuous(labels = function(x) paste0(round(100 * x, 1), " p.p.")) +
      labs(title = paste("Coeficientes del", input$f_mod), x = "Cambio en la probabilidad (IC 95 %)",
           y = NULL, caption = "Errores agrupados por hogar. Base: hombre soltero.") + tema
  })
  output$t_efecto <- renderTable(app_datos$efecto, digits = 4)
  output$g_pend <- renderPlot({
    ggplot(app_datos$pendientes, aes(estrato_grp, est, color = sexo)) +
      geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
      geom_pointrange(aes(ymin = lo, ymax = hi), position = position_dodge(.5)) +
      scale_y_continuous(labels = function(x) paste0(round(100 * x, 1), " p.p.")) +
      scale_color_manual(values = col_g) +
      labs(x = "Estrato de la vivienda", y = "Cambio en la probabilidad (IC 95 %)",
           color = "Sexo", caption = fuente) + tema
  })
  output$t_emp  <- renderTable(app_datos$emparejamiento, digits = 1)
  output$t_pruebas_geo <- renderTable(app_datos$pruebas_geo, digits = 4)
  output$t_dpto         <- renderTable(app_datos$dpto, digits = 2)
  output$g_mapa <- renderPlot({
    req(!is.null(app_datos$mapa))
    mp <- app_datos$mapa
    if (input$f_mapa == "lisa") {
      ggplot(mp) + geom_sf(aes(fill = lisa), color = "white", linewidth = 0.2) +
        scale_fill_manual(values = col_lisa, drop = FALSE) +
        coord_sf(xlim = c(-79.2, -66.8), ylim = c(-4.3, 12.6)) +
        labs(fill = "Clúster LISA", caption = fuente) + theme_void() + theme(legend.position = "right")
    } else {
      ggplot(mp) + geom_sf(aes(fill = 100 * .data[[input$f_mapa]]), color = "white", linewidth = 0.2) +
        scale_fill_distiller(palette = "YlOrRd", direction = ifelse(input$f_mapa == "asim_eb", 1, -1)) +
        coord_sf(xlim = c(-79.2, -66.8), ylim = c(-4.3, 12.6)) +
        labs(fill = "p.p.", caption = fuente) + theme_void() + theme(legend.position = "right")
    }
  })
}

