  tibble(cod_dpto = cd, n = nobs(m),
         hombres = ct["n_hijos_18", 1],       se_hombres = ct["n_hijos_18", 2],
         theta2  = ct["mujer:n_hijos_18", 1], se_theta2  = ct["mujer:n_hijos_18", 2],
         mujeres = r[["est"]],                se_mujeres = r[["se"]])
}))

# (b) ¿theta2 es igual en todos los departamentos? Modelo conjunto con una
# pendiente por departamento (base: Bogotá) y prueba de Wald de que todas las
# desviaciones son cero. EF de departamento x sexo y errores agrupados por hogar.
m_geo <- feols(univ ~ mujer * ec + edad + edad2 + n_hijos_18 + mujer_hijos +
                 i(cod_dpto, n_hijos_18, ref = "11") + i(cod_dpto, mujer_hijos, ref = "11") |
                 ANIO + cod_dpto^mujer + CLASE, data = d, cluster = ~ id_hogar)
w_geo <- wald(m_geo, keep = "^cod_dpto::.*:mujer_hijos$", print = FALSE)

# (c) Bayes empírico (DerSimonian y Laird): tau2 = varianza de la asimetría
# "verdadera" entre departamentos; lambda = peso de la estimación propia
eb_shrink <- function(est, se) {
  w <- 1 / se^2; mu <- sum(w * est) / sum(w); k <- length(est)
  Q <- sum(w * (est - mu)^2)
  tau2 <- max(0, (Q - (k - 1)) / (sum(w) - sum(w^2) / sum(w)))
  lambda <- tau2 / (tau2 + se^2)
  list(eb = mu + lambda * (est - mu), lambda = lambda, mu = mu, tau2 = tau2, Q = Q)
}
eb_t2 <- eb_shrink(res_dpto$theta2, res_dpto$se_theta2)
eb_mu <- eb_shrink(res_dpto$mujeres, res_dpto$se_mujeres)
