# Efecto marginal promedio de un hijo adicional en el logit, por sexo
# (diferencia de probabilidades predichas al sumar un hijo)
ame_hijos <- function(mod, datos, s) {
  dd <- datos %>% filter(mujer == s)
  p0 <- predict(mod, newdata = dd, type = "response")
  dd$n_hijos_18 <- dd$n_hijos_18 + 1
  p1 <- predict(mod, newdata = dd, type = "response")
  mean(p1 - p0, na.rm = TRUE)
}
