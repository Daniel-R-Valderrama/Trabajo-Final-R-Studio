formato <- function(df, titulo, decimales = 2, nota = NULL) {
  num <- names(df)[sapply(df, is.numeric)]
  ft <- flextable(df) %>%
    colformat_double(j = num, digits = decimales, big.mark = ".", decimal.mark = ",") %>%
    theme_booktabs() %>% set_caption(titulo) %>%
    fontsize(size = 9, part = "all") %>% font(fontname = "Times New Roman", part = "all") %>%
    bold(part = "header") %>% align(align = "center", part = "header") %>% autofit()
  if (!is.null(nota)) ft <- add_footer_lines(ft, nota)
  ft
}
