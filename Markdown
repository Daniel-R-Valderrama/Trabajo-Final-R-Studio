wm <- function(x, w) { ok <- !is.na(x); if (!any(ok)) NA_real_ else weighted.mean(x[ok], w[ok]) }
resumir_prop <- function(df, y) {
  df %>%
    summarise(n = n(), sw = sum(peso), swy = sum(peso * {{ y }}),
              neff = sum(peso)^2 / sum(peso^2), .groups = "drop") %>%
    mutate(prop = swy / sw, se = sqrt(prop * (1 - prop) / neff),
           lo = prop - 1.96 * se, hi = prop + 1.96 * se)
}
lincom <- function(mod, nombres) {
  b <- coef(mod)[nombres]; V <- vcov(mod)[nombres, nombres]
  est <- sum(b); se <- sqrt(sum(V))
  c(est = unname(est), se = unname(se), p = unname(2 * pnorm(-abs(est / se))))
}
fmt_p <- function(p) ifelse(p < 0.001, "< 0,001", formatC(p, format = "f", digits = 3, decimal.mark = ","))
tema  <- theme_minimal(base_size = 12) +
