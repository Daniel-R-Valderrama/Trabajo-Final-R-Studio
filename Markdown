ggplot(g1_data, aes(prop, ec, color = sexo)) +
  geom_errorbar(aes(xmin = lo, xmax = hi), width = 0.2, orientation = "y", linewidth = 0.8) +
  geom_point(size = 3.5) +
  scale_x_continuous(labels = percent_format(accuracy = 1)) +
  scale_color_manual(values = col_g) +
  labs(title = "Gráfica 1. Educación universitaria por condición conyugal y sexo",
       subtitle = "Proporción con universitaria o posgrado e intervalos de confianza del 95 %",
       x = "Proporción con universitaria o posgrado", y = "Condición conyugal",
