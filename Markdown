# ¿Los vecinos se parecen? Vecindad con st_touches() e I de Moran por permutación
vecinos <- st_touches(mapa_dpto)
W <- matrix(0, nrow(mapa_dpto), nrow(mapa_dpto))
for (i in seq_len(nrow(mapa_dpto))) W[i, vecinos[[i]]] <- 1
W <- W / pmax(rowSums(W), 1)
moran_I <- function(x, W) { z <- x - mean(x); (length(z) / sum(W)) * sum(W * outer(z, z)) / sum(z^2) }
x_asim <- -100 * mapa_dpto$theta2
I_obs <- moran_I(x_asim, W)
set.seed(2026); I_perm <- replicate(999, moran_I(sample(x_asim), W))
p_moran <- (sum(I_perm >= I_obs) + 1) / 1000
